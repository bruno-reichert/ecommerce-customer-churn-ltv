    mean_val = df["total_payment_value"].mean()
    sns.histplot(capped_values, bins=35, kde=True, color="#2980b9", ax=ax1, alpha=0.6)
    ax1.axvline(median_val, color="#e74c3c", linestyle="--", linewidth=2, label=f"Median: R$ {median_val:.2f}")
