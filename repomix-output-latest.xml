        color=color_line, 
        linewidth=2.5, 
        marker="o", 
        markersize=6,
        label="GMV (R$ Thousands)"
    )
    ax2.set_ylabel("Gross Merchandise Value (R$ Thousands)", color=color_line, fontweight="bold")
    ax2.tick_params(axis="y", labelcolor=color_line)
