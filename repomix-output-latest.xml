    print("=" * 60)
    print(f"First purchase date: {min_date}")
    print(f"Last purchase date:  {max_date}")
    print(f"Total span:          {(max_date - min_date).days} days")
    print("=" * 60)
if __name__ == "__main__":
    audit_order_dates()
