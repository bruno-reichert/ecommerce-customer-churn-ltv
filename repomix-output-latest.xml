        cust_actual = "Churned (1)" if y_test.iloc[idx] == 1 else "Active (0)"
        cust_spend = X_test_raw["total_spend"].iloc[idx]
        cust_delay = X_test_raw["max_delivery_delay"].iloc[idx]
