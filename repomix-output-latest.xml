# ==========================================
def test_model_predict_proba_bounds(df_customers, trained_pipeline):
    """Verifies that model outputs valid probabilities strictly between 0 and 1."""
    X, y, _, _ = prepare_features_and_target(df_customers)
    sample_X = X.iloc[:200]
